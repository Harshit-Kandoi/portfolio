{
  "name": "harshit-kandoi-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "npm run build && npm run lighthouse:mobile",
    "lighthouse:mobile": "lhci autorun --config=./lighthouserc.json",
    "lighthouse:desktop": "lhci autorun --config=./lighthouserc.json --collect.settings.preset=desktop",
    "fetch-medium": "node scripts/fetch-medium.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.344.0",
    "posthog-js": "^1.404.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "basic-ftp": "^6.2.3",
    "postcss-selector-parser": "^7.1.6"
  }
}
