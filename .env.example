# ============================================================
# Portfolio OS — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Analytics (optional) ────────────────────────────────────
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Supabase (optional — for live products data) ────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub API (optional — increases rate limit 60→5000/hr) ─
# Generate a classic personal access token at:
# https://github.com/settings/tokens/new
# Required scope: (none — public data only, no scopes needed)
# This is used by AboutApp's live stats bar to show total commits.
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App Versioning ──────────────────────────────────────────
VITE_APP_VERSION=2.4.0
VITE_ANALYTICS_VERSION=v1.0
