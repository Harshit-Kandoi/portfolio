# ============================================================
# Portfolio OS — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Analytics (optional) ────────────────────────────────────
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Supabase (optional — for live products data) ────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub API (optional, server-only) ──────────────────────
# Used by netlify/functions/github-stats.ts. NOT prefixed with VITE_, so it never
# reaches the browser. Optional: the function works without it (60 req/hr, CDN-cached).
# Create a fine-grained token with no permissions (public data only).
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Contact form (netlify/functions/send-email.ts) ──────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides. CONTACT_FROM must be a domain verified in Resend;
# the default onboarding@resend.dev only delivers to your Resend account email.
CONTACT_TO=hello@harshitkandoi.in
CONTACT_FROM=Portfolio <contact@harshitkandoi.in>
# Extra allowed origins (comma-separated) besides harshitkandoi.in and *.netlify.app
ALLOWED_ORIGINS=

# ── App Versioning ──────────────────────────────────────────
VITE_APP_VERSION=3.0.0
VITE_ANALYTICS_VERSION=v1.0
